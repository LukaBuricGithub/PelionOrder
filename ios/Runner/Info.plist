<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- A Croatian app (as in ikasa): iOS then draws its own parts of the
		     app — the camera permission buttons, the copy/paste menu — in
		     Croatian, and the App Store lists the language as Croatian. -->
		<key>CFBundleDevelopmentRegion</key>
		<string>hr</string>
		<key>CFBundleLocalizations</key>
		<array>
			<string>hr</string>
		</array>
		<key>CFBundleDisplayName</key>
		<string>Pelion Order</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Pelion Order</string>
		<!-- Export compliance: the app uses only standard encryption (TLS to the
		     MQTT broker), so App Store Connect doesn't hold each build for the
		     encryption questions. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- iPhone only (TARGETED_DEVICE_FAMILY = 1), portrait only, matching
		     the app's own lock in main.dart, so even the launch screen never
		     comes up sideways. -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSCameraUsageDescription</key>
		<string>Kamera se koristi za skeniranje QR kodova.</string>
	</dict>
</plist>
